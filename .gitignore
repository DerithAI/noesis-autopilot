# Node / npm
# Lockfiles are committed. They pin the versions, so a build today
# and a build next month are the same build. Measured 2026-10-24: no
# lockfile in the whole repository was tracked.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated by skill-forge
forge-*/

# Keep EVO-Bot artifact (must be AFTER forge-*/)
!forge-bot/

# Venture-Swarm deploy packages
!ventures/

